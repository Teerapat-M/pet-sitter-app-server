# Copy to .env and fill in real values. Never commit .env.
# Placeholders only — no live credentials.

# Direct Postgres URI (not the pooler) for npm run db:migrate and db:seed.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Comma-separated frontend origins for CORS. Localhost:3000/3001 (and 127.0.0.1) are always allowed.
# The first URL is the password-reset redirect base (no trailing slash).
FRONTEND_URL=http://localhost:3000

# Optional — required for booking payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional — Render sets PORT automatically
# PORT=4000
