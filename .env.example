# Copy to .env and fill in real values. Never commit .env.
# Placeholders only — no live credentials.

# Query pool. Production may use the Supabase transaction pooler (port 6543).
# Direct Postgres URI (port 5432) for npm run db:migrate and db:seed.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
# Optional. Session pooler (port 5432) or direct URI for LISTEN/NOTIFY.
# The transaction pooler (port 6543) cannot LISTEN — chat and walk SSE need this.
# Used only by the dedicated listener clients. Falls back to DATABASE_URL.
# Required in production when DATABASE_URL is a transaction pooler (6543 or pgbouncer).
# Must be a session (5432) or direct URI — a transaction-pooler LISTEN_DATABASE_URL fails at boot in production.
LISTEN_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Comma-separated frontend origins for CORS. Localhost:3000/3001 (and 127.0.0.1) are always allowed.
# The first URL is the password-reset redirect base (no trailing slash).
FRONTEND_URL=http://localhost:3000

# Optional — required for booking payments (Stripe TEST mode only; never commit live keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional — WebRTC TURN (ICE always includes stun:stun.l.google.com:19302).
# Placeholders only. Leave blank on the free tier if you have no TURN server.
TURN_URLS=turn:<host>:3478
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional — Render sets PORT automatically
# PORT=4000
